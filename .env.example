# Runtime environment: development | production | test
NODE_ENV=development
# HTTP port
PORT=3000
# Public base URL of this service (must be a URI)
PUBLIC_BASE_URL=http://localhost:3000
# Path of the JSON data file
DATA_FILE=./data/store.json
# Artificial storage latency in ms (0 = none)
STORAGE_LATENCY_MS=0
# REQUIRED: API key protecting the ops endpoints
OPS_API_KEY=change-me
# Guest device inbox endpoint deliveries are posted to (must be a URI)
GUEST_DEVICE_INBOX_URL=http://localhost:3000/guest-device/inbox
# Delivery worker tick interval in ms
DELIVERY_TICK_MS=1000
# Per-delivery HTTP timeout in ms
DELIVERY_TIMEOUT_MS=3000
# Lease duration in ms before a claimed delivery can be reclaimed
DELIVERY_LEASE_MS=15000
# Retry backoff base in ms
DELIVERY_BACKOFF_BASE_MS=1000
# Retry backoff cap in ms
DELIVERY_BACKOFF_MAX_MS=300000
# Failed attempts after which a delivery is flagged as needing attention
DELIVERY_ATTENTION_AFTER_ATTEMPTS=10
# Time in ms to let in-flight deliveries drain on shutdown
SHUTDOWN_DRAIN_MS=10000
# Log level
LOG_LEVEL=info
# Rate limit on POST /bookings per client IP (requests per minute)
THROTTLE_LIMIT_PER_MINUTE=100
# Sentry DSN (blank = off)
SENTRY_DSN=
# Better Stack source token (blank = off)
BETTERSTACK_SOURCE_TOKEN=
# Better Stack ingest host
BETTERSTACK_INGEST_HOST=https://in.logs.betterstack.com
# Pub/Sub emulator host, e.g. localhost:8085 (blank = Pub/Sub disabled)
PUBSUB_EMULATOR_HOST=
# GCP project id
GCP_PROJECT_ID=booking-local
# Pub/Sub topic name
PUBSUB_TOPIC=confirmation-deliveries
# Pub/Sub subscription name
PUBSUB_SUBSCRIPTION=confirmation-deliveries-sub
